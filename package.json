{
  "name": "hand-talk",
  "version": "0.1.0",
  "private": true,
  "description": "Medical-grade deaf patient communication bridge for radiology/radiotherapy departments",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144\" prisma generate && cross-env NODE_OPTIONS=\"--max-old-space-size=6144\" next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@prisma/client": "^6.2.1",
    "@radix-ui/primitive": "^1.1.3",
    "@radix-ui/react-primitive": "^2.1.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@serwist/next": "^9.5.6",
    "@serwist/precaching": "^9.5.6",
    "@serwist/routing": "^9.5.6",
    "@serwist/strategies": "^9.5.6",
    "@serwist/sw": "^9.5.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.2",
    "html2canvas": "^1.4.1",
    "jose": "^6.1.3",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.575.0",
    "next": "14.2.35",
    "next-intl": "^4.8.3",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.7.0",
    "serwist": "^9.5.6",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  }
}
