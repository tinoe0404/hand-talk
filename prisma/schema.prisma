generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Radiographer {
  id        String    @id @default(cuid())
  name      String
  pin       String    // Hashed PIN
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id              String           @id @default(cuid())
  startTime       DateTime         @default(now())
  endTime         DateTime?
  patientRef      String           // Anonymized patient reference
  isFirstDay      Boolean          @default(false)
  isLastDay       Boolean          @default(false)
  
  radiographer    Radiographer     @relation(fields: [radiographerId], references: [id])
  radiographerId  String

  instructionLogs InstructionLog[]
  gestureLogs     GestureLog[]
  emergencyLogs   EmergencyLog[]
}

model InstructionLog {
  id            String   @id @default(cuid())
  instructionId String   // ID from the 20 instructions
  timestamp     DateTime @default(now())
  
  session       Session  @relation(fields: [sessionId], references: [id])
  sessionId     String
}

model GestureLog {
  id          String   @id @default(cuid())
  gestureType String   // THUMBS_UP, OPEN_PALM, PEACE, POINT_DOWN
  confidence  Float
  timestamp   DateTime @default(now())
  
  session     Session  @relation(fields: [sessionId], references: [id])
  sessionId   String
}

model EmergencyLog {
  id              String   @id @default(cuid())
  stage           Int      // 1, 2, or 3
  triageSelection String?  // Selection from the triage cards
  timestamp       DateTime @default(now())
  
  session         Session  @relation(fields: [sessionId], references: [id])
  sessionId       String
}
